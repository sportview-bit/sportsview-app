datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Manager {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  phone        String
  email        String
  status       String   @default("pending")
  room         Room?
  createdAt    DateTime @default(now())
}

model Room {
  id        String   @id @default(cuid())
  name      String
  location  String
  manager   Manager  @relation(fields: [managerId], references: [id])
  managerId String   @unique
  entries   Entry[]
  createdAt DateTime @default(now())
}

model Match {
  id        String   @id @default(cuid())
  homeTeam  String
  awayTeam  String
  matchTime String
  entryFee  Int      @default(1000)
  status    String   @default("upcoming")
  entries   Entry[]
  createdAt DateTime @default(now())
}

model Sponsor {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String
  name               String
  amountSponsored    Int      @default(0)
  profitSharePercent Int      @default(0)
  createdAt          DateTime @default(now())
}

model User {
  id           String        @id @default(cuid())
  name         String
  phone        String        @unique
  email        String
  cardHash     String        @unique
  balance      Int           @default(0)
  entries      Entry[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model Entry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  room      Room     @relation(fields: [roomId], references: [id])
  roomId    String
  match     Match    @relation(fields: [matchId], references: [id])
  matchId   String
  amount    Int
  scannedAt DateTime @default(now())
}

model Transaction {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  amount    Int
  type      String
  method    String   @default("USSD")
  createdAt DateTime @default(now())
}